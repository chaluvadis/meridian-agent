@page "/"
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject TravelQueryOrchestrator Orchestrator
@inject IRulebookStore RulebookStore
@inject INearbyVenueStore NearbyVenueStore
@inject ITravelContextProvider ContextProvider
@inject ChatState ChatState
@inject MapState MapState
@inject IChatActivityTracker Activity
@inject IUserProfileService ProfileService
@inject ISynthesizerAgent Synthesizer
@inject IChatHistoryService History
@inject SpeechInterop Speech
@inject ILogger<Chat> Logger
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JSRuntime

@*
    The app is the conversation, so the page is three zones stacked full height: a context header
    (who this is for, and what the city is doing right now), the transcript, and the composer. The
    map is not a destination — it slides up as a sheet inside the chat when a plan has places in it,
    or on request from the header.
*@
<div class="chat-shell">
    <header class="chat-header">
        <div class="chat-header-main">
            <div>
                <p class="chat-header-greeting">Good @TimeOfDay, @_firstName</p>
                <h1 class="chat-header-title">@GreetingMessage</h1>
            </div>

            <div class="chat-header-meta">
                @if (_context is not null)
                {
                    <div class="weather-pill">
                        <MudIcon Icon="@WeatherIcon" Size="Size.Small" Class="weather-pill-icon" />
                        <span class="weather-pill-text">@_context.WeatherSummary</span>
                    </div>
                    <span class="chat-header-time">@_context.LocalTime</span>
                }
            </div>
        </div>

        @if (MapState.Venues.Count > 0)
        {
            <button class="chat-nearby-toggle" @onclick="ToggleMap">
                <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />
                <span>@(_showMap ? "Hide nearby" : "Nearby")</span>
            </button>
        }

        @* Reading a past day is not today: the header says so and offers the way back. *@
        @if (ChatState.IsViewingHistory)
        {
            <div class="chat-history-banner">
                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="chat-history-banner-icon" />
                <span class="chat-history-banner-text">Reading @ChatState.SessionDate.ToString("MMMM d")</span>
                <button class="chat-history-back" @onclick="ShowTodayAsync">Back to today</button>
            </div>
        }
    </header>

    @* The map, when it is relevant: a sheet that rises over the transcript instead of a route.
       It lives inside the message area so the composer stays usable underneath it. *@
    <div class="chat-body">
        <div class="chat-messages" @ref="_messagesContainer" id="chat-messages">
            @if (ChatState.Messages.Count == 0 && ChatState.StreamingContent is null)
            {
                <div class="chat-empty">
                    <div class="chat-empty-orb">
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Class="chat-empty-orb-icon" />
                    </div>
                    <h2 class="chat-empty-title">Where to next, @_firstName?</h2>
                    <p class="chat-empty-body">@_emptyStatePitch</p>
                </div>
            }

            @foreach (var message in ChatState.Messages)
            {
                var isPivot = message.Type == MessageType.WeatherPivot;
                var bubbleClass = isPivot
                    ? "chat-bubble chat-assistant chat-pivot"
                    : message.Type == MessageType.Proactive
                        ? "chat-bubble chat-assistant chat-proactive"
                        : message.Role == "user"
                            ? "chat-bubble chat-user"
                            : "chat-bubble chat-assistant";

                <div class="chat-message-row @(message.Role == "user" ? "chat-message-row-user" : null)">
                    @if (message.Role != "user")
                    {
                        <div class="chat-avatar" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Small" />
                        </div>
                    }

                    <div class="chat-message-main">
                        @if (isPivot)
                        {
                            <div class="pivot-badge">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                Weather change
                            </div>
                        }
                        else if (message.Type == MessageType.Proactive)
                        {
                            <div class="proactive-badge">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                                Suggestion for you
                            </div>
                        }

                        <div class="@bubbleClass">
                            @message.Content
                        </div>
                        <div class="chat-message-meta">
                            <span class="chat-timestamp">@message.Timestamp.ToString("HH:mm")</span>

                            @* Only the agent's own words are worth keeping: a heart on the traveler's
                           own line would be a bookmark of something they wrote themselves. *@
                            @if (message.Role != "user")
                            {
                                <button class="chat-favorite @(message.IsFavorite ? "chat-favorite-on" : null)"
                                        aria-label="@(message.IsFavorite ? "Remove from saved" : "Save this answer")"
                                        aria-pressed="@message.IsFavorite"
                                        disabled="@(message.StoredId is null || ChatState.IsBusy)"
                                        @onclick="() => ToggleFavoriteAsync(message)">
                                    <MudIcon
                                    Icon="@(message.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder)"
                                    Size="Size.Small" />
                                </button>

                                <button class="chat-speak @(_speakingMessageId == message.Id ? "chat-speak-on" : null)"
                                        aria-label="@(_speakingMessageId == message.Id ? "Stop reading this aloud" : "Read this aloud")"
                                        aria-pressed="@(_speakingMessageId == message.Id)"
                                        @onclick="() => ToggleSpeakingAsync(message)">
                                    <MudIcon
                                    Icon="@(_speakingMessageId == message.Id ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                                    Size="Size.Small" />
                                </button>
                            }
                        </div>

                        @if (message.QuickActions is { Count: > 0 })
                        {
                            <div class="quick-actions @(message.Role == "user" ? "quick-actions-user" : null)">
                                @foreach (var action in message.QuickActions)
                                {
                                    <MudChip T="string" Text="@action.Label" Color="Color.Secondary" Variant="Variant.Outlined"
                                             Size="Size.Medium" Disabled="@ChatState.IsBusy" OnClick="() => HandleQuickAction(action)"
                                             Class="quick-action-chip" />
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (ChatState.StreamingContent is not null)
            {
                <div class="chat-message-row">
                    <div class="chat-avatar" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Small" />
                    </div>
                    <div class="chat-message-main">
                        <div class="chat-bubble chat-assistant">
                            @ChatState.StreamingContent<span class="chat-cursor">&nbsp;</span>
                        </div>
                    </div>
                </div>
            }
            else if (ChatState.IsBusy)
            {
                <div class="chat-message-row">
                    <div class="chat-avatar" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Small" />
                    </div>
                    <div class="chat-typing" aria-label="Thinking">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            }
        </div>

        @if (_showMap)
        {
            <div class="map-sheet-backdrop" @onclick="ToggleMap"></div>
            <section class="map-sheet">
                <div class="map-sheet-grabber" aria-hidden="true"></div>

                <header class="map-sheet-header">
                    <div>
                        <h2 class="map-sheet-title">Nearby suggestions</h2>
                        <p class="map-sheet-subtitle">@MapState.CenterLabel</p>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" aria-label="Close the map"
                                   OnClick="ToggleMap" />
                </header>

                <div class="map-sheet-body">
                    <LeafletMap Venues="MapState.Venues" Landmarks="MapState.Landmarks" FocusLabel="MapState.FocusLabel" />

                    @if (MapState.Venues.Count == 0)
                    {
                        <p class="map-sheet-empty">Ask for something and I will fill the map in.</p>
                    }
                    else
                    {
                        <ol class="map-sheet-list">
                            @foreach (var venue in MapState.Venues)
                            {
                                <li class="map-sheet-item">
                                    <strong>@venue.Name</strong>
                                    <span class="map-sheet-item-meta">@venue.Category · @venue.TravelTimeMinutes min away</span>
                                    <span class="map-sheet-item-why">@venue.WhyItFits</span>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </section>
        }
    </div>

    <footer class="chat-composer">
        @if (ChatState.Messages.Count == 0 && ChatState.StreamingContent is null && !ChatState.IsBusy)
        {
            <div class="chat-suggestions">
                @foreach (var suggestion in _suggestions)
                {
                    <button class="chat-suggestion" @onclick="() => SendAsync(suggestion)" disabled="@ChatState.IsBusy">
                        @suggestion
                    </button>
                }
            </div>
        }

        <div class="chat-input">
            <input class="chat-input-field"
                   placeholder="@(_listening ? "Listening…" : "How are you feeling right now?")"
                   aria-label="Ask The Meridian Agent" @bind="_query" @bind:event="oninput"
                   disabled="@(ChatState.IsBusy || _listening)" @onkeydown="OnKeyDown" />
            <button class="chat-mic @(_listening ? "chat-mic-on" : null)" @onclick="ToggleListeningAsync"
                    disabled="@(ChatState.IsBusy || !_speechSupported)"
                    aria-label="@(_listening ? "Stop listening" : "Talk to The Meridian Agent")" aria-pressed="@_listening"
                    title="@(_speechSupported ? "Speak your question" : "This browser cannot listen")">
                <MudIcon Icon="@(_listening ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)"
                         Size="Size.Small" />
            </button>
            <button class="chat-send" @onclick="() => SendAsync(_query)"
                    disabled="@(ChatState.IsBusy || string.IsNullOrWhiteSpace(_query))" aria-label="Send">
                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
            </button>
        </div>

        <p class="chat-composer-note">Meridian reads the hour, the weather, and what you have told me about you</p>
    </footer>
</div>


