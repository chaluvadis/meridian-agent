# The Meridian Agent - environment template.
# Copy to .env (docker compose reads it automatically) and fill in the keys you have.
# Only KILO_API_KEY is required: the app refuses to start without it, because there is no
# local model to fall back to.
#
# SECURITY: .env is git-ignored and must never be committed. The container reads it as
# AI__ApiKey; the image itself is built without it (.dockerignore excludes it).

# Required: your Kilo AI Gateway key from https://app.kilo.ai/profile. One key serves every
# model on the gateway (Anthropic, Google, xAI, DeepSeek, MiniMax and more).
KILO_API_KEY=

# The gateway base URL. Only point this elsewhere to use another OpenAI-compatible host.
AI_BASE_URL=https://api.kilo.ai/api/gateway

# The chat model every agent runs on. Model IDs are "provider/model-name" — browse the full list with:
#   curl https://api.kilo.ai/api/gateway/models
# Fast and cheap options: anthropic/claude-haiku-4.5, google/gemini-2.5-flash,
# deepseek/deepseek-v3.2, moonshotai/kimi-k2.5. Automatic routing: kilo-auto/efficient.
AI_MODEL=anthropic/claude-sonnet-4.6

# EMBEDDINGS ARE OFF BY DEFAULT: the gateway serves chat models only, so there is nothing to
# embed with and the safeguard reads the full rulebook (a handful of rules per destination).
# To turn the Qdrant vector search on, set an embedding model served by an OpenAI-compatible
# host — text-embedding-3-small is 1536 numbers, text-embedding-3-large is 3072 — and make
# QDRANT_VECTOR_SIZE match it. Leave both empty to keep vector search off.
AI_EMBEDDING_MODEL=
QDRANT_VECTOR_SIZE=1536

# Sampling and reply length when a call does not set its own values.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# Seconds before a model call is abandoned, and how many times a transient failure is retried.
AI_REQUEST_TIMEOUT_SECONDS=120
AI_RETRY_COUNT=2

# Optional: live weather. Without it the app reads samples/travel_context.json.
WEATHER_API_KEY=

# Optional: the host port the web app is published on.
WEB_PORT=8080
