@inherits LayoutComponentBase
@using MeridianAgent.Web.Components.Theme
@inject NavigationManager Navigation

@*
    Main shell: existing sidebar navigation, plus the MudBlazor providers that give every page the
    Meridian theme, and the settings entry point in the app bar.
*@
<MudThemeProvider Theme="MeridianTheme.Meridian" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-between">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Color="Color.Inherit"
                           Size="Size.Medium"
                           aria-label="Edit traveler profile"
                           title="Edit traveler profile"
                           OnClick="GoToProfileEdit" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void GoToProfileEdit() => Navigation.NavigateTo("/profile/edit");
}
