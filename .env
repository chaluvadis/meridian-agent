# The Meridian Agent - environment for docker-compose
# Copy to .env (docker compose reads .env automatically). Never commit real keys.

# OpenWeatherMap API key for live weather context (optional; falls back to samples/travel_context.json)
WEATHER_API_KEY=

# Ollama connection (inside the compose network, use the service name)
OLLAMA_BASE_URL=http://ollama:11434

# Qdrant vector database (inside the compose network, use the service name)
QDRANT_ENDPOINT=http://qdrant:6333
