@page "/"
@page "/chat"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject TravelQueryOrchestrator Orchestrator
@inject IUserProfileStore ProfileStore
@inject IRulebookStore RulebookStore
@inject INearbyVenueStore NearbyVenueStore
@inject ITravelContextProvider ContextProvider
@inject ChatState ChatState
@inject MapState MapState
@inject IChatActivityTracker Activity
@inject IJSRuntime JSRuntime

<div class="chat-shell">
    <div class="chat-toolbar">
        <div>
            <strong>@_profileName</strong>
            <span class="text-muted"> @(_destination)</span>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleMap" disabled="@(ChatState.IsBusy)">
            @(_showMap ? "Hide map" : "Show map")
        </button>
    </div>

    @if (_showMap)
    {
        <LeafletMap Venues="MapState.Venues" Landmarks="MapState.Landmarks" />
    }

    <div class="chat-messages" @ref="_messagesContainer">
        @if (ChatState.Messages.Count == 0 && ChatState.StreamingContent is null)
        {
            <div class="chat-empty">
                <p>Where would you like to go — and how are you feeling right now?</p>
            </div>
        }

        @foreach (var message in ChatState.Messages)
        {
            var bubbleClass = message.Type == MessageType.Proactive
                ? "chat-bubble chat-assistant chat-proactive"
                : message.Role == "user"
                    ? "chat-bubble chat-user"
                    : "chat-bubble chat-assistant";

            <div class="@bubbleClass">
                @if (message.Type == MessageType.Proactive)
                {
                    <div class="proactive-badge">💡 Suggestion</div>
                }
                <div class="chat-content">@message.Content</div>
                <div class="chat-timestamp">@message.Timestamp.ToString("HH:mm")</div>
            </div>
        }

        @if (ChatState.StreamingContent is not null)
        {
            <div class="chat-bubble chat-assistant">@ChatState.StreamingContent<span class="chat-cursor">&nbsp;</span></div>
        }
        else if (ChatState.IsBusy)
        {
            <div class="chat-bubble chat-assistant text-muted">Thinking…</div>
        }
    </div>

    <div class="chat-suggestions">
        @foreach (var suggestion in _suggestions)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="() => SendAsync(suggestion)" disabled="@ChatState.IsBusy">@suggestion</button>
        }
    </div>

    <div class="chat-input">
        <input class="form-control" placeholder="Ask The Meridian Agent…" @bind="_query" @bind:event="oninput"
               disabled="@ChatState.IsBusy" @onkeydown="OnKeyDown" />
        <button class="btn btn-primary" @onclick="() => SendAsync(_query)" disabled="@(ChatState.IsBusy || string.IsNullOrWhiteSpace(_query))">Send</button>
    </div>
</div>

@code {
    private readonly string[] _suggestions = new[]
    {
        "I've been walking all day - somewhere calm for dinner?",
        "We're exhausted, anywhere good nearby?",
        "Want to see the old souks before they close?",
    };

    private HubConnection? _hubConnection;
    private ElementReference _messagesContainer;
    private string _query = string.Empty;
    private bool _showMap;
    private UserProfile _profile = UserProfile.Default;
    private DestinationRulebook? _rulebook;
    private string _profileName = "Traveler";
    private string _destination = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ChatState.Changed += OnStateChanged;

        _profile = await ProfileStore.GetAsync("default") ?? UserProfile.Default;
        _profileName = _profile.DisplayName;
        _destination = _profile.Destination;

        if (!string.IsNullOrWhiteSpace(_profile.Destination))
        {
            _rulebook = await RulebookStore.GetAsync(_profile.Destination);
        }

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chatHub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<string, string>("ReceiveProactiveMessage", (messageId, content) =>
        {
            ChatState.AddProactive(messageId, content);

            // A proactive message is agent activity: keep the session fresh enough for more.
            Activity.RecordActivity();

            return InvokeAsync(async () =>
            {
                StateHasChanged();
                await ScrollToBottomAsync();
            });
        });

        try
        {
            await _hubConnection.StartAsync();
            Activity.RecordActivity();
        }
        catch (Exception)
        {
            // The chat still works without the hub; only proactive messages need it.
        }
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SendAsync(_query);
        }
    }

    private void ToggleMap() => _showMap = !_showMap;

    private async Task SendAsync(string query)
    {
        if (ChatState.IsBusy || string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        Activity.RecordActivity();
        await PingHubAsync();

        _query = string.Empty;
        ChatState.AddUser(query);
        ChatState.BeginAssistant();
        StateHasChanged();

        TravelRequest? request = null;

        try
        {
            request = await BuildRequestAsync(query);

            await foreach (var token in Orchestrator.StreamAsync(request))
            {
                ChatState.AppendAssistant(token);
                await Task.Yield();
            }
        }
        catch (Exception ex)
        {
            ChatState.AppendAssistant($"I hit a snag: {ex.Message}");
        }
        finally
        {
            ChatState.EndAssistant();

            var venues = Orchestrator.Blackboard.Itinerary?.Venues ?? Array.Empty<Venue>();
            MapState.SetVenues(venues);
            MapState.SetLandmarks(request?.NearbyVenues ?? Array.Empty<NearbyVenue>(), request?.Context.Location ?? _destination);

            if (!_showMap && venues.Count > 0)
            {
                _showMap = true;
            }

            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    private async Task<TravelRequest> BuildRequestAsync(string query)
    {
        var location = string.IsNullOrWhiteSpace(_profile.HomeBase) ? _profile.Destination : _profile.HomeBase;
        var context = await ContextProvider.GetCurrentAsync(location);

        var nearby = await NearbyVenueStore.GetAsync(context.Location);
        var rulebook = _rulebook ?? await RulebookStore.GetAsync(_profile.Destination) ?? new DestinationRulebook
        {
            Destination = _profile.Destination,
            Rules = Array.Empty<SafeguardRule>(),
        };

        return new TravelRequest(query, _profile, context, nearby, rulebook);
    }

    private Task PingHubAsync() => _hubConnection is null || _hubConnection.State != HubConnectionState.Connected
        ? Task.CompletedTask
        : _hubConnection.InvokeAsync("Ping");

    private Task ScrollToBottomAsync()
    {
        try
        {
            return JSRuntime.InvokeVoidAsync("scrollChatToBottom", _messagesContainer).AsTask();
        }
        catch (JSException)
        {
            // JS may be unavailable during prerender; scrolling is best-effort.
            return Task.CompletedTask;
        }
        catch (ObjectDisposedException)
        {
            return Task.CompletedTask;
        }
    }

    public async ValueTask DisposeAsync()
    {
        ChatState.Changed -= OnStateChanged;

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
