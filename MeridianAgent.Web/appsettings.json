{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "RequestTimeoutSeconds": 300,
    "RetryCount": 2,
    "Temperature": 0.2,
    "MaxTokens": 1024,
    "EmbeddingModel": "nomic-embed-text",
    "SanitizerModel": "qwen2.5:1.5b"
  },
  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "ApiKey": "",
    "CollectionPrefix": "meridian",
    "VectorSize": 768,
    "Distance": "Cosine"
  },
  "Storage": {
    "DataDirectory": "samples",
    "ProfilesSubdirectory": "profiles",
    "RulebooksSubdirectory": "rulebooks"
  },
  "Weather": {
    "BaseUrl": "https://api.openweathermap.org",
    "ApiKey": ""
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org"
  },
  "Osrm": {
    "BaseUrl": "https://router.project-osrm.org",
    "Profile": "driving"
  }
}
