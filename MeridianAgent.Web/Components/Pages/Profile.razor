@page "/profile"
@rendermode InteractiveServer
@inject IUserProfileStore ProfileStore

<PageTitle>Profile</PageTitle>

<h3>Traveler profile</h3>
<p class="text-muted">These preferences feed the Context and Safeguard agents.</p>

@if (_saved)
{
    <div class="alert alert-success">Profile saved.</div>
}

<EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="profile">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Display name</label>
            <InputText @bind-Value="_model.DisplayName" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Destination</label>
            <InputText @bind-Value="_model.Destination" class="form-control" placeholder="Dubai, UAE" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Traveler profile</label>
            <InputSelect @bind-Value="_model.TravelerProfile" class="form-select">
                @foreach (var option in Enum.GetValues<TravelerProfile>())
                {
                    <option value="@option">@option</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Group composition</label>
            <InputSelect @bind-Value="_model.GroupComposition" class="form-select">
                @foreach (var option in Enum.GetValues<GroupComposition>())
                {
                    <option value="@option">@option</option>
                }
            </InputSelect>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Pacing</label>
            <InputSelect @bind-Value="_model.Pacing" class="form-select">
                @foreach (var option in Enum.GetValues<PacingPreference>())
                {
                    <option value="@option">@option</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Budget</label>
            <InputSelect @bind-Value="_model.Budget" class="form-select">
                @foreach (var option in Enum.GetValues<BudgetRange>())
                {
                    <option value="@option">@option</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Home base (for live context)</label>
            <InputText @bind-Value="_model.HomeBase" class="form-control" placeholder="Downtown Dubai" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Dietary rules (comma separated)</label>
        <InputText @bind-Value="_model.Dietary" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Interests (comma separated)</label>
        <InputText @bind-Value="_model.Interests" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Avoid list (comma separated)</label>
        <InputText @bind-Value="_model.Avoid" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Attire note (for the safeguard agent)</label>
        <InputText @bind-Value="_model.AttireNote" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save profile</button>
</EditForm>

@code {
    private ProfileEditModel _model = new();
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await ProfileStore.GetAsync("default") ?? UserProfile.Default;
        _model = ProfileEditModel.From(loaded);
    }

    private async Task SaveAsync()
    {
        await ProfileStore.SaveAsync(_model.ToProfile());
        _saved = true;
    }

    private sealed class ProfileEditModel
    {
        public string DisplayName { get; set; } = "Traveler";

        public string Destination { get; set; } = string.Empty;

        public TravelerProfile TravelerProfile { get; set; } = TravelerProfile.FirstTime;

        public GroupComposition GroupComposition { get; set; } = GroupComposition.Solo;

        public PacingPreference Pacing { get; set; } = PacingPreference.Moderate;

        public BudgetRange Budget { get; set; } = BudgetRange.Medium;

        public string? HomeBase { get; set; }

        public string? AttireNote { get; set; }

        public string Dietary { get; set; } = string.Empty;

        public string Interests { get; set; } = string.Empty;

        public string Avoid { get; set; } = string.Empty;

        public static ProfileEditModel From(UserProfile profile) => new()
        {
            DisplayName = profile.DisplayName,
            Destination = profile.Destination,
            TravelerProfile = profile.TravelerProfile,
            GroupComposition = profile.GroupComposition,
            Pacing = profile.Pacing,
            Budget = profile.Budget,
            HomeBase = profile.HomeBase,
            AttireNote = profile.AttireNote,
            Dietary = string.Join(", ", profile.DietaryRules),
            Interests = string.Join(", ", profile.Interests),
            Avoid = string.Join(", ", profile.AvoidList),
        };

        public UserProfile ToProfile() => new()
        {
            Id = "default",
            DisplayName = DisplayName,
            Destination = Destination,
            TravelerProfile = TravelerProfile,
            GroupComposition = GroupComposition,
            Pacing = Pacing,
            Budget = Budget,
            HomeBase = HomeBase,
            AttireNote = AttireNote,
            DietaryRules = Split(Dietary),
            Interests = Split(Interests),
            AvoidList = Split(Avoid),
        };

        private static IReadOnlyList<string> Split(string value) =>
            string.IsNullOrWhiteSpace(value)
                ? Array.Empty<string>()
                : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }
}
