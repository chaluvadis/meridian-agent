@inherits LayoutComponentBase
@using MeridianAgent.Web.Components.Theme
@inject NavigationManager Navigation
@inject IUserProfileService ProfileService
@inject GeolocationInterop Geolocation

@*
    The whole app is the chat, so the shell is deliberately thin: one top app bar that names the
    product, shows where the traveler is, and carries the two ways to look sideways - the history
    glance and the settings. No sidebar, no nav items - everything else in the app is contextual.
*@
<MudThemeProvider Theme="MeridianTheme.Create()" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar-fixed" Fixed="false">
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center justify-space-between app-bar-inner">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Explore" Class="brand-icon" />
                <MudText Typo="Typo.h6" Class="brand-name">Meridian</MudText>
            </div>

            <div class="d-flex align-center gap-1 gap-sm-3">
                @if (!string.IsNullOrWhiteSpace(_location))
                {
                    <MudText Typo="Typo.body2" Class="app-bar-location">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="app-bar-location-icon" />
                        @_location
                    </MudText>
                }

                <button class="app-bar-icon"
                        aria-label="Open the glance panel"
                        title="Saved answers and past days"
                        @onclick="OpenGlance">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                </button>

                @* The one thing that measures rather than infers. Shown until a position is known,
                   because a traveler who has shared one has no reason to be asked again. *@
                @if (!_hasPosition)
                {
                    <button class="app-bar-icon @(_locating ? "app-bar-icon-busy" : null)"
                            aria-label="Use my current location"
                            title="Find me. Answers where, not just which city."
                            disabled="@_locating"
                            @onclick="LocateAsync">
                        <MudIcon Icon="@(_locating ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.MyLocation)"
                                 Size="Size.Small" />
                    </button>
                }

                <button class="app-bar-icon"
                        aria-label="Edit traveler profile"
                        title="Edit traveler profile"
                        @onclick="GoToProfileEdit">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                </button>
            </div>
        </MudContainer>
    </MudAppBar>

    <MudMainContent Class="app-main">
        <div class="app-content">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<GlancePanel @bind-Visible="_showGlance" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _location = string.Empty;
    private bool _showGlance;
    private bool _locating;
    private bool _hasPosition;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await ProfileService.GetProfileAsync("default");

            // The bar shows where the traveler is, resolved by the same single rule the chat
            // header and the pipeline use so they cannot drift apart.
            _location = profile?.EffectiveLocation ?? string.Empty;
            _hasPosition = profile?.HasCoordinates ?? false;
        }
        catch (Exception)
        {
            // The chat is the point; an unreadable profile must not blank the whole page.
        }
    }

    private void GoToProfileEdit() => Navigation.NavigateTo("/profile/edit");

    private void OpenGlance() => _showGlance = true;

    /// <summary>
    /// Finds out where the traveler is and remembers it. Stays on the prompt for a refusal or a
    /// timeout rather than hiding it, so a traveler who dismissed the browser box by accident can
    /// try again without a reload.
    /// </summary>
    private async Task LocateAsync()
    {
        if (_locating)
        {
            return;
        }

        _locating = true;

        try
        {
            var position = await Geolocation.GetPositionAsync();
            var profile = await ProfileService.GetProfileAsync(IUserProfileService.DefaultProfileId);

            if (position is null || profile is null)
            {
                return;
            }

            var located = profile with
            {
                Latitude = position.Latitude,
                Longitude = position.Longitude,
            };

            await ProfileService.SaveProfileAsync(located);

            _hasPosition = located.HasCoordinates;
        }
        catch (Exception)
        {
            // A refusal or a failed save leaves the app exactly as it was: still the city they typed.
        }
        finally
        {
            _locating = false;
        }
    }
}
