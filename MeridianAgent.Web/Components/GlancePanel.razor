@using MeridianAgent.Application
@using MeridianAgent.Domain.Entities
@using MeridianAgent.Web.Components.State
@implements IDisposable
@inject IChatHistoryService History
@inject ChatState ChatState
@inject IDialogService Dialogs
@inject ISynthesizerAgent Synthesizer
@inject IUserProfileService ProfileService
@inject IJSRuntime JSRuntime

@*
    "Glance" is the anti-scroll view: everything the traveler saved, and everything they said, day
    by day, without going back through the transcript. It is a right-hand drawer on a wide screen
    and a bottom sheet on a phone, and it is opened from the clock icon in the app bar.

    It reads and writes through the same ChatState the chat page uses, so picking a day here
    changes what the chat shows — the panel is a view onto the conversation, not a copy of it.
*@
@if (Visible)
{
    <div class="glance-backdrop" @onclick="HideAsync"></div>

    <aside class="glance-panel">
        <header class="glance-header">
            <div class="glance-handle" aria-hidden="true"></div>

            <div class="glance-heading">
                <h2 class="glance-title">Glance</h2>
                <p class="glance-subtitle">@_subtitle</p>
            </div>

            <button class="glance-close" aria-label="Close the glance panel" @onclick="HideAsync">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>
        </header>

        <MudTabs Rounded="true" Elevation="0" Class="glance-tabs" TabPanelsClass="glance-tab-panels">
            <MudTabPanel Text="Saved" Style="font-family: inherit;">
                @if (_itinerary is not null)
                {
                    @* The compiled day, set like a printed document: this is the thing worth
                       reading carefully, and the only place in the app that asks to be. *@
                    <div class="glance-itinerary">
                        <div class="glance-itinerary-gutter" aria-hidden="true"></div>

                        <div class="glance-itinerary-body">
                            <div class="glance-itinerary-rule"></div>

                            <h3 class="glance-itinerary-heading">Your day, compiled</h3>
                            <p class="glance-itinerary-subheading">@_itinerarySubtitle</p>

                            <pre class="glance-itinerary-text">@_itinerary</pre>

                            <div class="glance-itinerary-actions">
                                <button class="glance-itinerary-button glance-itinerary-primary" disabled="@_compiling"
                                        @onclick="CopyItineraryAsync">
                                    <MudIcon Icon="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)"
                                             Size="Size.Small" />
                                    @(_copied ? "Copied" : "Copy to clipboard")
                                </button>
                                <button class="glance-itinerary-button" disabled="@_compiling" @onclick="DiscardItineraryAsync">
                                    Back to saved
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="glance-itinerary-launch">
                        <button class="glance-compile" disabled="@(_favorites.Count == 0 || _compiling)"
                                @onclick="CompileItineraryAsync">
                            @if (_compiling)
                            {
                                <span class="glance-compile-spinner" aria-hidden="true"></span>
                                <span>Compiling your day…</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                                <span>Compile Itinerary</span>
                            }
                        </button>
                        <p class="glance-compile-hint">
                            @(_favorites.Count == 0
                                ? "Save a few answers and I will lay them out as a day."
                                : $"Built from the {_favorites.Count} answer{(_favorites.Count == 1 ? "" : "s")} you saved today.")
                        </p>
                    </div>

                    @if (_favorites.Count == 0)
                    {
                        <div class="glance-empty">
                            <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Class="glance-empty-icon" />
                            <p>Nothing saved yet.</p>
                            <p class="glance-empty-hint">Tap the heart under an answer you want to keep an eye on.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="glance-favorites">
                            @foreach (var favorite in _favorites)
                            {
                                <li class="glance-favorite">
                                    <div class="glance-favorite-meta">
                                        <span class="glance-favorite-day">@favorite.DayLabel</span>
                                        <span class="glance-favorite-time">@favorite.Stamp</span>
                                    </div>
                                    <p class="glance-favorite-preview">@favorite.Preview</p>
                                    <button class="glance-favorite-view" @onclick="() => OpenAsync(favorite)">
                                        View
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                }
            </MudTabPanel>

            <MudTabPanel Text="Timeline" Style="font-family: inherit;">
                @if (_days.Count == 0)
                {
                    <div class="glance-empty">
                        <MudIcon Icon="@Icons.Material.Filled.History" Class="glance-empty-icon" />
                        <p>No days yet.</p>
                        <p class="glance-empty-hint">Each day you talk to Meridian shows up here.</p>
                    </div>
                }
                else
                {
                    <ol class="glance-timeline">
                        @foreach (var day in _days)
                        {
                            <li class="glance-day @(day.IsToday ? "glance-day-today" : null)">
                                <button class="glance-day-button" @onclick="() => OpenDayAsync(day)">
                                    <span class="glance-day-marker" aria-hidden="true"></span>
                                    <span class="glance-day-body">
                                        <span class="glance-day-title">Day @day.DayNumber · @day.Label</span>
                                        <span class="glance-day-count">@day.Count</span>
                                        @if (day.IsToday)
                                        {
                                            <span class="glance-day-badge">Today</span>
                                        }
                                    </span>
                                </button>
                            </li>
                        }
                    </ol>
                }
            </MudTabPanel>
        </MudTabs>
    </aside>
}
