<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeridianAgent.Core\MeridianAgent.Core.csproj" />
    <ProjectReference Include="..\MeridianAgent.Infrastructure\MeridianAgent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\samples\**\*.json" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\samples\**\*.md" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
