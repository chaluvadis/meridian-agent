{
  "ConnectionStrings": {
    "Meridian": "Data Source=meridian.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "BaseUrl": "https://api.kilo.ai/api/gateway",
    "ApiKey": "",
    "Model": "anthropic/claude-sonnet-4.6",
    "EmbeddingModel": "",
    "Temperature": 0.2,
    "MaxTokens": 2048,
    "RequestTimeoutSeconds": 120,
    "RetryCount": 2
  },
  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "ApiKey": "",
    "CollectionPrefix": "meridian",
    "VectorSize": 1536,
    "Distance": "Cosine"
  },
  "Storage": {
    "DataDirectory": "samples",
    "ProfilesSubdirectory": "profiles",
    "RulebooksSubdirectory": "rulebooks"
  },
  "Weather": {
    "BaseUrl": "https://api.openweathermap.org",
    "ApiKey": ""
  },
  "Proactive": {
    "Enabled": true,
    "IntervalHours": 4,
    "MinConfidenceScore": 0.55,
    "CooldownHours": 2,
    "ActiveWithinMinutes": 30
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org"
  },
  "Osrm": {
    "BaseUrl": "https://router.project-osrm.org",
    "Profile": "driving"
  }
}
