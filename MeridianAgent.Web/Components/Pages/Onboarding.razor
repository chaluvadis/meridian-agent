@page "/onboarding"
@layout OnboardingLayout
@using MeridianAgent.Web.Components.Onboarding
@inject IJSRuntime JSRuntime

@* First-time travelers only: the router redirects here until a profile exists, and back to the
   chat once this wizard has been completed. *@
<OnboardingWizard Mode="WizardMode.Onboarding" />

@code {
    protected override Task OnAfterRenderAsync(bool firstRender) =>
        BrowserTitle.SetAsync(JSRuntime, firstRender, "Welcome — The Meridian Agent");
}
