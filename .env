# The Meridian Agent - environment for docker-compose
# Copy to .env (docker compose reads .env automatically). Never commit real keys.

# OpenWeatherMap API key for live weather context (optional; falls back to samples/travel_context.json)
WEATHER_API_KEY=

# Host port for the Blazor app (container always listens on 8080)
WEB_PORT=8080

# The containerized Ollama is reachable inside the compose network at http://ollama:11434
# and is NOT published to the host, so it cannot clash with a host-installed Ollama on 11434.
# To publish it anyway on a free host port, set e.g. OLLAMA_HOST_PORT=11435 and uncomment
# the ports mapping in the ollama service of docker-compose.yml.
OLLAMA_HOST_PORT=

# Qdrant dashboard/API host ports (used by the web app at http://qdrant:6333 internally)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
